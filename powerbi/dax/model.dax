// ============================================================================
// DAX voor de cashflow-template
// 1. Maak de berekende tabellen via Modellering > Nieuwe tabel.
// 2. Relatie: Kalender[Datum] (1) -> Cashflow[Kwartaal] (*), enkelvoudig filter.
// 3. Markeer Kalender als datumtabel (kolom Datum).
// 4. Maak de measures via Modellering > Nieuwe meting (bij voorkeur in een
//    lege tabel "_Measures"). De NAMEN moeten exact zo blijven: de Deneb-spec
//    verwijst ernaar.
// ============================================================================


// ---------- Berekende tabel: Kalender (één rij per kwartaal) ----------
Kalender =
VAR _Start = MIN ( Cashflow[Kwartaal] )
VAR _Eind  = MAX ( Cashflow[Kwartaal] )
VAR _Real  = MAX ( Instellingen[RealisatieTotEnMet] )
RETURN
    SELECTCOLUMNS (
        FILTER (
            CALENDAR ( _Start, _Eind ),
            DAY ( [Date] ) = 1 && MOD ( MONTH ( [Date] ) - 1, 3 ) = 0
        ),
        "Datum", [Date],
        "Jaar", YEAR ( [Date] ),
        "Kwartaal", YEAR ( [Date] ) & "-Q" & QUARTER ( [Date] ),       // sorteerbaar: 2026-Q3
        "Kwartaal label", "Q" & QUARTER ( [Date] ) & " '" & RIGHT ( YEAR ( [Date] ), 2 ),
        "Realisatie", IF ( [Date] <= _Real, 1, 0 )
    )
// Zet bij Kalender[Realisatie] de samenvatting op "Niet samenvatten".


// ---------- Berekende tabel: Scenario keuze (voor de slicer) ----------
Scenario keuze =
DATATABLE ( "Scenario", STRING, { { "Scenario 1" }, { "Scenario 2" }, { "Scenario 3" } } )
// Geen relatie leggen. Zet er een slicer op (meervoudige selectie):
// niets geselecteerd = geen scenariolijnen.


// ============================== Measures ===================================

// Hulp: realisatiegrens
_Realisatie t/m =
MAX ( Instellingen[RealisatieTotEnMet] )

// Hulp: netto cashflow (opbrengsten + negatieve kosten), alle versies
_Netto =
SUM ( Cashflow[Opbrengsten] ) + SUM ( Cashflow[Kosten] )

// Balken -------------------------------------------------------------------
Opbrengsten =
CALCULATE ( SUM ( Cashflow[Opbrengsten] ), Cashflow[Versie] = "Actueel" )

Kosten =
CALCULATE ( SUM ( Cashflow[Kosten] ), Cashflow[Versie] = "Actueel" )

// Lijnen -------------------------------------------------------------------
Cumulatieve cashflow =
VAR _d = MAX ( Kalender[Datum] )
RETURN
    CALCULATE (
        [_Netto],
        Cashflow[Versie] = "Actueel",
        REMOVEFILTERS ( Kalender ),
        Kalender[Datum] <= _d
    )

Vorige prognose =
VAR _d = MAX ( Kalender[Datum] )
RETURN
    CALCULATE (
        [_Netto],
        Cashflow[Versie] = "Vorige prognose",
        REMOVEFILTERS ( Kalender ),
        Kalender[Datum] <= _d
    )

// Scenario's starten op de actuele stand (laatste realisatiekwartaal) en
// tellen daarna de kwartalen van het scenario op. Alleen zichtbaar als het
// scenario in de slicer "Scenario keuze" is geselecteerd.
Scenario 1 =
VAR _naam = "Scenario 1"
VAR _d    = MAX ( Kalender[Datum] )
VAR _r    = [_Realisatie t/m]
VAR _aan  = ISFILTERED ( 'Scenario keuze'[Scenario] ) && _naam IN VALUES ( 'Scenario keuze'[Scenario] )
VAR _stand =
    CALCULATE ( [_Netto], Cashflow[Versie] = "Actueel", REMOVEFILTERS ( Kalender ), Kalender[Datum] <= _r )
VAR _toekomst =
    CALCULATE ( [_Netto], Cashflow[Versie] = _naam, REMOVEFILTERS ( Kalender ), Kalender[Datum] > _r, Kalender[Datum] <= _d )
RETURN
    IF ( _aan && _d >= _r, _stand + _toekomst )

Scenario 2 =
VAR _naam = "Scenario 2"
VAR _d    = MAX ( Kalender[Datum] )
VAR _r    = [_Realisatie t/m]
VAR _aan  = ISFILTERED ( 'Scenario keuze'[Scenario] ) && _naam IN VALUES ( 'Scenario keuze'[Scenario] )
VAR _stand =
    CALCULATE ( [_Netto], Cashflow[Versie] = "Actueel", REMOVEFILTERS ( Kalender ), Kalender[Datum] <= _r )
VAR _toekomst =
    CALCULATE ( [_Netto], Cashflow[Versie] = _naam, REMOVEFILTERS ( Kalender ), Kalender[Datum] > _r, Kalender[Datum] <= _d )
RETURN
    IF ( _aan && _d >= _r, _stand + _toekomst )

Scenario 3 =
VAR _naam = "Scenario 3"
VAR _d    = MAX ( Kalender[Datum] )
VAR _r    = [_Realisatie t/m]
VAR _aan  = ISFILTERED ( 'Scenario keuze'[Scenario] ) && _naam IN VALUES ( 'Scenario keuze'[Scenario] )
VAR _stand =
    CALCULATE ( [_Netto], Cashflow[Versie] = "Actueel", REMOVEFILTERS ( Kalender ), Kalender[Datum] <= _r )
VAR _toekomst =
    CALCULATE ( [_Netto], Cashflow[Versie] = _naam, REMOVEFILTERS ( Kalender ), Kalender[Datum] > _r, Kalender[Datum] <= _d )
RETURN
    IF ( _aan && _d >= _r, _stand + _toekomst )


// KPI-kaarten (optioneel) --------------------------------------------------
Dieptepunt =
MINX ( ALL ( Kalender[Datum] ), [Cumulatieve cashflow] )

Dieptepunt kwartaal =
VAR _min = [Dieptepunt]
RETURN
    MAXX (
        TOPN ( 1, FILTER ( ALL ( Kalender ), [Cumulatieve cashflow] = _min ), Kalender[Datum], ASC ),
        Kalender[Kwartaal label]
    )

Stand realisatie =
VAR _r = [_Realisatie t/m]
RETURN
    CALCULATE ( [Cumulatieve cashflow], REMOVEFILTERS ( Kalender ), Kalender[Datum] = _r )

Eindsaldo =
VAR _laatste = CALCULATE ( MAX ( Kalender[Datum] ), REMOVEFILTERS ( Kalender ) )
RETURN
    CALCULATE ( [Cumulatieve cashflow], REMOVEFILTERS ( Kalender ), Kalender[Datum] = _laatste )
